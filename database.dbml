Table users {
  id bigint [pk, increment]
  name varchar [not null]
  email varchar [not null]
  phone varchar [not null]
  password varchar [not null]
  avatar varchar [not null]
  role enum [not null]
  status enum [not null]
  email_verified_at timestamp [not null]
  remember_token varchar
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp
  apartment_id bigint [not null]
  cccd varchar [not null]
  banned_posting_until timestamp [not null]
  banned_commenting_until timestamp [not null]
}

Table blocks {
  id bigint [pk, increment]
  name varchar [not null]
  code varchar [not null]
  status enum [not null]
  manager_name varchar [not null]
  manager_contact varchar [not null]
  description text [not null]
  created_at timestamp
  updated_at timestamp
}

Table floors {
  id bigint [pk, increment]
  block_id bigint [not null]
  floor_number integer [not null]
  name varchar [not null]
  status enum [not null]
  description text [not null]
  created_at timestamp
  updated_at timestamp
  // Index: ['block_id', 'floor_number']
  floor_type varchar [not null]
}

Table apartments {
  id bigint [pk, increment]
  floor_id bigint [not null]
  apartment_number varchar [not null]
  area decimal [not null]
  status enum [not null]
  description text [not null]
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp
  // Index: ['floor_id', 'apartment_number']
}

Table apartment_invites {
  id bigint [pk, increment]
  apartment_id bigint [not null]
  created_by bigint [not null]
  invite_code varchar [not null]
  intended_relationship enum [not null]
  status enum [not null]
  expired_at timestamp [not null]
  created_at timestamp
  updated_at timestamp
  block_id bigint [not null]
  max_uses integer [not null]
  uses_count integer [not null]
  note varchar [not null]
}

Table residents {
  id bigint [pk, increment]
  user_id bigint [not null]
  apartment_id bigint [not null]
  invite_id bigint [not null]
  relationship enum [not null]
  temporary_status enum [not null]
  start_date date [not null]
  end_date date [not null]
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp
  // Index: ['user_id', 'apartment_id']
}

Table invitations {
  id bigint [pk, increment]
  code varchar [not null]
  role enum [not null]
  permissions json [not null]
  max_uses integer [not null]
  uses_count integer [not null]
  expires_at timestamp [not null]
  created_by bigint [not null]
  created_at timestamp
  updated_at timestamp
}

Table parking_lots {
  id bigint [pk, increment]
  lot_number varchar [not null]
  lot_type enum [not null]
  status enum [not null]
  apartment_id bigint [not null]
  created_at timestamp
  updated_at timestamp
  capacity integer [not null]
  zone varchar [not null]
}

Table vehicles {
  id bigint [pk, increment]
  apartment_id bigint [not null]
  parking_lot_id bigint [not null]
  license_plate varchar [not null]
  brand varchar [not null]
  image varchar [not null]
  qr_code varchar [not null]
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table vehicle_logs {
  id bigint [pk, increment]
  vehicle_id bigint [not null]
  checked_in_by bigint [not null]
  checked_out_by bigint [not null]
  check_in_at timestamp [not null]
  check_out_at timestamp [not null]
  qr_code varchar [not null]
  status enum [not null]
  // Index: 'vehicle_id'
  // Index: ['status']
  // Index: ['qr_code']
  created_at timestamp
  updated_at timestamp
}

Table service_prices {
  id bigint [pk, increment]
  name varchar [not null]
  type enum [not null]
  unit_price decimal [not null]
  status enum [not null]
  description text [not null]
  created_at timestamp
  updated_at timestamp
}

Table utility_meters {
  id bigint [pk, increment]
  apartment_id bigint [not null]
  type enum [not null]
  record_month smallint [not null]
  record_year smallint [not null]
  old_value integer [not null]
  ocr_value integer [not null]
  new_value integer [not null]
  usage_amount integer [not null]
  image_proof varchar [not null]
  recorded_by bigint [not null]
  created_at timestamp
  updated_at timestamp
  // Index: ['apartment_id', 'type', 'record_month', 'record_year'], 'utility_meters_period_unique'
  // Index: 'type', 'idx_meter_type'
  status enum [not null]
  is_reset boolean [not null]
  rejected_by bigint [not null]
  reject_reason varchar [not null]
  images text [not null]
}

Table bills {
  id bigint [pk, increment]
  apartment_id bigint [not null]
  title varchar [not null]
  billing_month smallint [not null]
  billing_year smallint [not null]
  due_date date [not null]
  total_amount decimal [not null]
  status enum [not null]
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp
  // Index: ['billing_year', 'billing_month'], 'idx_bills_month'
  paid_amount decimal [not null]
  created_by bigint [not null]
}

Table bill_details {
  id bigint [pk, increment]
  bill_id bigint [not null]
  service_price_id bigint [not null]
  quantity decimal [not null]
  amount decimal [not null]
  created_at timestamp [not null]
  status varchar [not null]
}

Table payments {
  id bigint [pk, increment]
  bill_id bigint [not null]
  amount decimal [not null]
  payment_method enum [not null]
  transaction_code varchar [not null]
  status enum [not null]
  paid_at timestamp [not null]
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp
  // Index: 'status', 'idx_payments_status'
  note text [not null]
  recorded_by bigint [not null]
  refunded_at timestamp [not null]
  refund_note text [not null]
  refunded_by bigint [not null]
  receipt_code varchar [not null]
  vnp_txn_ref varchar [not null]
  proof_image varchar [not null]
  payer_name varchar [not null]
}

Table tickets {
  id bigint [pk, increment]
  apartment_id bigint [not null]
  sender_id bigint [not null]
  handler_id bigint [not null]
  title varchar [not null]
  description text [not null]
  image varchar [not null]
  priority enum [not null]
  status enum [not null]
  rating smallint [not null]
  feedback_comment text [not null]
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp
  // Index: 'status', 'idx_tickets_status'
  images json [not null]
  reopened_count smallint [not null]
}

Table ticket_progress {
  id bigint [pk, increment]
  ticket_id bigint [not null]
  status varchar [not null]
  comment text [not null]
  image_proof varchar [not null]
  updated_by bigint [not null]
  created_at timestamp [not null]
}

Table facilities {
  id bigint [pk, increment]
  name varchar [not null]
  capacity integer [not null]
  description text [not null]
  status enum [not null]
  created_at timestamp
  updated_at timestamp
  open_time time [not null]
  close_time time [not null]
  slot_duration smallint [not null]
  price_per_slot decimal [not null]
  rules text [not null]
  images json [not null]
}

Table facility_bookings {
  id bigint [pk, increment]
  facility_id bigint [not null]
  user_id bigint [not null]
  booking_date date [not null]
  start_time time [not null]
  end_time time [not null]
  status enum [not null]
  created_at timestamp
  updated_at timestamp
  number_of_people integer [not null]
  qr_code varchar [not null]
  checked_in_at datetime [not null]
  payment_status enum [not null]
  payment_method varchar [not null]
  bill_id bigint [not null]
}

Table posts {
  id bigint [pk, increment]
  user_id bigint [not null]
  title varchar [not null]
  content text [not null]
  image varchar [not null]
  price decimal [not null]
  status enum [not null]
  ai_flagged enum [not null]
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp
  reports_count integer [not null]
}

Table comments {
  id bigint [pk, increment]
  post_id bigint [not null]
  user_id bigint [not null]
  parent_id bigint [not null]
  content text [not null]
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp
  image_path varchar [not null]
  is_pinned boolean [not null]
}

Table visitors {
  id bigint [pk, increment]
  apartment_id bigint [not null]
  guest_name varchar [not null]
  guest_phone varchar [not null]
  qr_token varchar [not null]
  expired_at timestamp [not null]
  check_in_at timestamp [not null]
  check_out_at timestamp [not null]
  check_in_by bigint [not null]
  check_out_by bigint [not null]
  created_at timestamp
  updated_at timestamp
  registered_by bigint [not null]
  status enum [not null]
  note text [not null]
  vehicle_plate varchar [not null]
  vehicle_type varchar [not null]
}

Table notifications {
  id varchar [not null]
  type varchar [not null]
  notifiable_type varchar [not null]
  notifiable_id bigint [not null]
  data json [not null]
  read_at timestamp [not null]
  created_at timestamp [not null]
  // Index: ['notifiable_type', 'notifiable_id'], 'idx_notifications_notifiable'
  updated_at timestamp [not null]
}

Table system_settings {
  id bigint [pk, increment]
  setting_key varchar [not null]
  setting_value text [not null]
  created_at timestamp
  updated_at timestamp
}

Table apartment_members {
  id bigint [pk, increment]
  apartment_id bigint [not null]
  invite_id bigint [not null]
  name varchar [not null]
  birth_year varchar [not null]
  relationship varchar [not null]
  status enum [not null]
  verified_at timestamp [not null]
  created_at timestamp
  updated_at timestamp
}

Table post_reports {
  id bigint [pk, increment]
  post_id bigint [not null]
  user_id bigint [not null]
  reason varchar [not null]
  created_at timestamp
  updated_at timestamp
  // Index: ['post_id', 'user_id']
}

Table post_images {
  id bigint [pk, increment]
  post_id bigint [not null]
  image_path varchar [not null]
  created_at timestamp
  updated_at timestamp
}

Table comment_reports {
  id bigint [pk, increment]
  comment_id bigint [not null]
  user_id bigint [not null]
  reason varchar [not null]
  created_at timestamp
  updated_at timestamp
  // Index: ['comment_id', 'user_id']
}

Table likes {
  id bigint [pk, increment]
  user_id bigint [not null]
  likeable_id bigint
  likeable_type varchar
  created_at timestamp
  updated_at timestamp
  // Index: ['user_id', 'likeable_type', 'likeable_id']
  type varchar [not null]
}

Table utility_meter_logs {
  id bigint [pk, increment]
  utility_meter_id bigint [not null]
  apartment_id bigint [not null]
  user_id bigint [not null]
  type varchar [not null]
  record_month integer [not null]
  record_year integer [not null]
  old_value integer [not null]
  new_value integer [not null]
  action varchar [not null]
  reject_reason text [not null]
  created_at timestamp
  updated_at timestamp
}

Table announcements {
  id bigint [pk, increment]
  user_id bigint [not null]
  title varchar [not null]
  content text [not null]
  category enum [not null]
  status enum [not null]
  pinned boolean [not null]
  image_path varchar [not null]
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table activity_log {
  id bigint [pk, increment]
  log_name varchar [not null]
  description text [not null]
  subject_id bigint
  subject_type varchar
  event varchar [not null]
  causer_id bigint
  causer_type varchar
  attribute_changes json [not null]
  properties json [not null]
  created_at timestamp
  updated_at timestamp
  batch_uuid varchar [not null]
}

// Relationships
Ref: apartments.id < users.apartment_id
Ref: blocks.id < floors.block_id
Ref: floors.id < apartments.floor_id
Ref: apartments.id < apartment_invites.apartment_id
Ref: users.id < apartment_invites.created_by
Ref: blocks.id < apartment_invites.block_id
Ref: users.id < residents.user_id
Ref: apartments.id < residents.apartment_id
Ref: apartment_invites.id < residents.invite_id
Ref: users.id < invitations.created_by
Ref: apartments.id < parking_lots.apartment_id
Ref: apartments.id < vehicles.apartment_id
Ref: parking_lots.id < vehicles.parking_lot_id
Ref: vehicles.id < vehicle_logs.vehicle_id
Ref: users.id < vehicle_logs.checked_in_by
Ref: users.id < vehicle_logs.checked_out_by
Ref: apartments.id < utility_meters.apartment_id
Ref: users.id < utility_meters.recorded_by
Ref: users.id < utility_meters.rejected_by
Ref: apartments.id < bills.apartment_id
Ref: users.id < bills.created_by
Ref: bills.id < bill_details.bill_id
Ref: service_prices.id < bill_details.service_price_id
Ref: bills.id < payments.bill_id
Ref: users.id < payments.recorded_by
Ref: users.id < payments.refunded_by
Ref: apartments.id < tickets.apartment_id
Ref: users.id < tickets.sender_id
Ref: users.id < tickets.handler_id
Ref: tickets.id < ticket_progress.ticket_id
Ref: users.id < ticket_progress.updated_by
Ref: facilities.id < facility_bookings.facility_id
Ref: users.id < facility_bookings.user_id
Ref: bills.id < facility_bookings.bill_id
Ref: users.id < posts.user_id
Ref: posts.id < comments.post_id
Ref: users.id < comments.user_id
Ref: comments.id < comments.parent_id
Ref: apartments.id < visitors.apartment_id
Ref: users.id < visitors.registered_by
Ref: apartments.id < apartment_members.apartment_id
Ref: apartment_invites.id < apartment_members.invite_id
Ref: posts.id < post_reports.post_id
Ref: users.id < post_reports.user_id
Ref: posts.id < post_images.post_id
Ref: comments.id < comment_reports.comment_id
Ref: users.id < comment_reports.user_id
Ref: users.id < likes.user_id
Ref: utility_meters.id < utility_meter_logs.utility_meter_id
Ref: apartments.id < utility_meter_logs.apartment_id
Ref: users.id < utility_meter_logs.user_id
Ref: users.id < announcements.user_id